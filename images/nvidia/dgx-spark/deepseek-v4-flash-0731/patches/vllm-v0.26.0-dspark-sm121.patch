+def _get_aligned_workspace_tensor(
+    shape: tuple[int, ...],
+    dtype: torch.dtype,
+    alignment: int = 32,
+) -> torch.Tensor:
+    """Return a workspace view with the alignment required by CUTLASS DSL.
+
+    WorkspaceManager aligns suballocation sizes, but the CUDA pointer backing a
+    reused workspace is not part of that API contract.  The DeepSeek-V4
+    dequant-gather CUTLASS kernel requires its BF16 output pointer to be aligned
+    to 32 bytes.  Reserve a small byte prefix and align the live pointer rather
+    than creating a persistent per-layer tensor or allocating during execution.
+    """
+    assert alignment > 0 and alignment & (alignment - 1) == 0
+    numel = 1
+    for dim in shape:
+        numel *= dim
+    nbytes = numel * dtype.itemsize
+    raw = current_workspace_manager().get_simultaneous(
+        (((nbytes + alignment - 1),), torch.uint8),
+    )[0]
+    offset = (-raw.data_ptr()) % alignment
+    aligned = raw[offset : offset + nbytes].view(dtype).reshape(shape)
+    assert aligned.data_ptr() % alignment == 0
+    return aligned
+
