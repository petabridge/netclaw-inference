+
+
+@torch.inference_mode()
+def test_torch_compile_flat_synthetic_base():
+    """The opaque op must not inspect the rank of an AOT synthetic base."""
+    num_tokens, num_heads, n_groups = 7, 64, 8
+    heads_per_group = num_heads // n_groups
+    max_pos = 4096
+    base = torch.randn(
+        num_tokens * num_heads * HEAD_DIM,
+        device="cuda",
+        dtype=torch.bfloat16,
+    )
+    positions = torch.randint(
+        0, max_pos, (num_tokens,), device="cuda", dtype=torch.long
+    )
+    cos_sin_cache = make_cos_sin_cache(max_pos, device="cuda")
+
+    def run(flat, pos, cache):
+        logical = flat.view(num_tokens, num_heads, HEAD_DIM)
+        return fused_inv_rope_fp8_quant(
+            logical,
+            pos,
+            cache,
+            n_groups,
+            heads_per_group,
+            tma_aligned_scales=True,
+        )
+
+    expected_fp8, expected_scale = run(base, positions, cos_sin_cache)
+    compiled = torch.compile(run, fullgraph=True, dynamic=True)
+    actual_fp8, actual_scale = compiled(base, positions, cos_sin_cache)
+    assert torch.equal(actual_fp8, expected_fp8)
+    assert torch.equal(actual_scale, expected_scale)
