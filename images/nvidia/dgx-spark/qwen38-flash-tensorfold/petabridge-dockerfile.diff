+# PETABRIDGE: upstream passed the image's hash in as PATCHES_HASH (recipe/scripts/config.sh
+# image_hash(): sha256 over patches/*.patch, the heredoc itself and the build inputs, first 12 hex
+# characters). Nothing passes it here, so it is recorded literally below and verified in this
+# stage, computed exactly as image_hash() would compute it with 0010 placed in recipe/patches/
+# (upstream's own 0001-0009 give f3e1300f4f62, the published image's tag). The label is the key
+# recipe/scripts/prepare.sh and start.sh compare and cache kernels under, so a deployment that
+# adds 0010 to its recipe's patches/ computes the same value.
+COPY recipe/scripts/prepare.sh /tmp/recipe-prepare.sh
+RUN set -eu; \
+    computed="$( { cat /opt/tf-patches/*.patch; \
+                   sed -n "/<<.DOCKERFILE./,/^DOCKERFILE\$/p" /tmp/recipe-prepare.sh; \
+                   echo "${TF_REPO} ${TF_REF} zig-${ZIG_VERSION} ${ZIG_SHA256} nvcr.io/nvidia/pytorch:26.07-py3 kernel-mtime-${KERNEL_SOURCE_MTIME}"; \
+                 } | sha256sum | cut -c1-12 )"; \
+    echo "image hash $computed"; test "$computed" = "50cb44760834"
 
-FROM ${BASE_IMAGE}
+# PETABRIDGE: the same digest-pinned base (upstream `FROM ${BASE_IMAGE}`).
+FROM nvcr.io/nvidia/pytorch:26.07-py3@sha256:7531d90bcbe0e43e1f7363029c7e145ce90eebeb494a7b4695fdba0329d7c3c3
 COPY --from=build /opt/tensorfold /opt/tensorfold
