+# Qwen3.8-Flash-Next NVFP4 on TensorFold's Zig engine (tensorfold-native) for two NVIDIA DGX Sparks (GB10,
+# sm_121), with Petabridge's 0010-media-prompt-reuse patch. PROTOTYPE: image.json has build_enabled false.
+#
+# Materialized by Petabridge from the upstream recipe's inline Dockerfile:
+# MiaAI-Lab/Qwen3.8-Flash-Dual-DGX-Sparks-TensorFold, recipe/scripts/prepare.sh, the
+# `docker build ... -f - "$ctx"` heredoc (lines 175-220), at commit
+# be3ed857ab1055ca47b36134d22691f00f2bb94a. The heredoc is not a file upstream, so this is a
+# materialization, not a copy: every change against it is marked "PETABRIDGE:" below and is
+# recorded in ./petabridge-dockerfile.diff. See ./README.md and ./dependency.lock.json.
+#
+# The build context is this folder (image.json -> context): the vendored recipe/ and
+# petabridge-patches/ both have to reach the build.
+
+# PETABRIDGE: literal digest-pinned base image (the linux/arm64 manifest of
+# nvcr.io/nvidia/pytorch:26.07-py3, resolvable anonymously). Upstream: `ARG BASE_IMAGE=...`
+# followed by `FROM ${BASE_IMAGE} AS build`; this repository prohibits base-image build arguments.
+FROM nvcr.io/nvidia/pytorch:26.07-py3@sha256:7531d90bcbe0e43e1f7363029c7e145ce90eebeb494a7b4695fdba0329d7c3c3 AS build
+# PETABRIDGE: upstream took these as build arguments passed by recipe/scripts/prepare.sh from
+# recipe/scripts/config.sh; scripts/build-image.sh passes only the arguments declared in
+# image.json, so config.sh's values at the pinned commit are materialized as defaults.
+ARG ZIG_VERSION=0.17.0
+ARG ZIG_SHA256=9e8d11661d4ae3bd57702a3832781e23ad151dde5798e16a5ccd503f65234ff8
 RUN curl -fsSL -o /tmp/zig.tar.xz "https://ziglang.org/download/${ZIG_VERSION}/zig-aarch64-linux-${ZIG_VERSION}.tar.xz" && \
     echo "${ZIG_SHA256}  /tmp/zig.tar.xz" | sha256sum -c - && \
     mkdir -p /opt/zig && tar -xJf /tmp/zig.tar.xz -C /opt/zig --strip-components=1 && rm /tmp/zig.tar.xz && \
     /opt/zig/zig version
-ARG TF_REPO
-ARG TF_REF
+# PETABRIDGE: TF_REPO / TF_REF materialized (config.sh). TF_REF is already an immutable commit
+# (branch zig-flashnext), and the checkout below asserts it.
+ARG TF_REPO=https://github.com/ashhart/TensorFold.git
+ARG TF_REF=db281878ddb836fd0df510d8771ecb7e0fe47d26
 RUN git init -q /tensorfold && cd /tensorfold && git remote add origin "${TF_REPO}" && \
     git fetch -q --depth 1 origin "${TF_REF}" && git checkout -q --detach FETCH_HEAD && \
     test "$(git rev-parse HEAD)" = "${TF_REF}"
-COPY patches /opt/tf-patches
+# PETABRIDGE: upstream `COPY patches /opt/tf-patches` with a build context of the recipe's patches/
+# only. Here the context is this folder: the recipe's 0001-0009, then Petabridge's 0010 (kept
+# outside the vendored recipe), into one directory; the loop below applies them in filename
+# order, unchanged.
+COPY recipe/patches/ /opt/tf-patches/
+COPY petabridge-patches/ /opt/tf-patches/
 RUN cd /tensorfold && \
     for p in /opt/tf-patches/*.patch; do [ -e "$p" ] || continue; echo "applying $p"; git apply --check "$p" && git apply "$p" || exit 1; done
 RUN cd /tensorfold && /opt/zig/zig build -Dnvcc=/usr/local/cuda/bin/nvcc -Doptimize=fast --prefix /opt/tensorfold \
@@ -22,7 +47,9 @@
