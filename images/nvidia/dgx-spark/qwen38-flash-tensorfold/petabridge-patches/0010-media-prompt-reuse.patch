+def test_feature_cache_is_least_recently_used_within_its_bytes():
+    torch = pytest.importorskip("torch")
+    cache = FeatureCache(3 * 4 * 2 * 2)                 # two [4, 3] bf16 entries... and a bit
+    a, b, c = (torch.full((4, 3), float(i), dtype=torch.bfloat16) for i in range(3))
+    cache.put("a", a)
+    cache.put("b", b)
+    assert cache.get("a") is a                          # a is now the most recent
+    cache.put("c", c)                                   # evicts b
+    assert cache.get("b") is None and cache.get("a") is a and cache.get("c") is c
+    assert cache.held <= cache.limit
+    cache.put("huge", torch.zeros((100, 3), dtype=torch.bfloat16))   # past the limit: not kept
+    assert cache.get("huge") is None and cache.get("a") is a
+
+
+def _vision(cache):
+    torch = pytest.importorskip("torch")
+    from tensorfold.vision.qwen_cuda import QwenCudaVision
+
+    v = object.__new__(QwenCudaVision)
+    v.config = dict(CONFIG["vision_config"])
+    v.videos = False
+    v.image_token = 10
+    v.media_tokens = frozenset({10})
+    v.device = torch.device("cpu")
+    v.calls = []
+
+    def tower(pixels, grid_thw, return_dict):
+        v.calls.append(int(grid_thw.shape[0]))
+        rows = pixels.shape[0] // 4
+        base = pixels.float().reshape(rows, 4, -1).mean(dim=(1, 2), keepdim=False)
+        out = torch.stack([base, base * 2, base + torch.arange(rows, dtype=torch.float32)], dim=1)
+        return NS(pooler_output=out)
+
+    v.tower = tower
+    if cache:
+        v.feature_cache = FeatureCache(1 << 20)
+    return v
+
+
+def test_the_feature_cache_encodes_each_picture_once_and_gives_the_same_rows():
+    torch = pytest.importorskip("torch")
+    vision = _vision(cache=True)
+    two = front().prepare(prompt(2), [picture("a"), picture("b")], max_visual_tokens=64, fixed_image_tokens=16)
+    first = vision._encode(two, two.token_ids)
+    assert vision.cache_hits == 0 and vision.calls == [1, 1]          # each picture alone
+    three = front().prepare(prompt(3), [picture("a"), picture("b"), picture("c")], max_visual_tokens=64,
+                            fixed_image_tokens=16)
+    vision.calls.clear()
+    second = vision._encode(three, three.token_ids)
+    assert vision.cache_hits == 2 and vision.calls == [1]             # only the new picture through the tower
+    rows_two = first.features.shape[0]
+    assert torch.equal(second.features[:rows_two], first.features)    # the earlier pictures' rows, bit for bit
+    fresh = _vision(cache=True)._encode(three, three.token_ids)
+    assert torch.equal(second.features, fresh.features)               # a hit equals a fresh encode
+
+
+def test_without_the_cache_the_tower_runs_the_request_together_as_upstream():
+    pytest.importorskip("torch")
+    vision = _vision(cache=False)
+    two = front().prepare(prompt(2), [picture("a"), picture("b")], max_visual_tokens=64, fixed_image_tokens=16)
+    vision._encode(two, two.token_ids)
+    assert vision.calls == [2]
+
+
+def test_env_int_bounds():
+    import os
+
+    os.environ["TF_TEST_MEDIA_INT"] = "12"
+    try:
+        assert media_keys.env_int("TF_TEST_MEDIA_INT", 1, 0, 100) == 12
+        with pytest.raises(ValueError):
+            media_keys.env_int("TF_TEST_MEDIA_INT", 1, 0, 10)
+    finally:
+        del os.environ["TF_TEST_MEDIA_INT"]
+    assert media_keys.env_int("TF_TEST_MEDIA_INT", 7, 0, 10) == 7
