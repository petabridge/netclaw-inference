+    }.of;
+    const rows = [_]u32{ 2, 3, 4, 7, 8 };
+    const ok = parseSpans(a, try parse(a, "[[2,5,\"00000000000000aa\"],[7,9,\"ffffffffffffffff\"]]"), &rows, 10);
+    try std.testing.expectEqual(@as(usize, 2), ok.len);
+    try std.testing.expectEqual(@as(u64, 0xaa), ok[0].key);
+    try std.testing.expectEqual(@as(u32, 7), ok[1].start);
+    try std.testing.expectEqual(@as(u64, 0xffffffffffffffff), ok[1].key);
+    // a span that misses a feature row, a row past the prompt, a short key, overlapping spans, none at all
+    try std.testing.expectEqual(@as(usize, 0), parseSpans(a, try parse(a, "[[2,5,\"00000000000000aa\"]]"), &rows, 10).len);
