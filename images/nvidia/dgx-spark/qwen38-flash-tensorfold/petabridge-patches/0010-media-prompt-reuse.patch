diff --git a/tests/test_media_prompt_reuse.py b/tests/test_media_prompt_reuse.py
new file mode 100644
index 0000000..195bad4
--- /dev/null
+++ b/tests/test_media_prompt_reuse.py
@@ -0,0 +1,198 @@
+"""PETABRIDGE 0010: image prompts' content keys, the fixed per-image cap and the helper's feature cache (CPU only)."""
+
+from __future__ import annotations
+
+import hashlib
+from types import SimpleNamespace as NS
+
+import numpy as np
+import pytest
+
+from tensorfold.vision import media_keys
+from tensorfold.vision.media_keys import FeatureCache, image_key, item_keys
+from tensorfold.vision.qwen_processing import QwenImageProcessor
+
+CONFIG = {"model_type": "qwen3_5", "image_token_id": 10, "video_token_id": 11,
+          "vision_start_token_id": 8, "vision_end_token_id": 9,
+          "vision_config": {"spatial_merge_size": 2, "patch_size": 16, "temporal_patch_size": 2,
+                            "out_hidden_size": 3, "in_channels": 3}}
+SPECIAL = {"<start>": 8, "<end>": 9, "<image>": 10}
+
+
+class Tokenizer:
+    def convert_ids_to_tokens(self, token):
+        return {v: k for k, v in SPECIAL.items()}.get(token)
+
+    def convert_tokens_to_ids(self, token):
+        return SPECIAL.get(token)
+
+    def __call__(self, text, **kwargs):
+        ids = []
+        while text:
+            found = next((t for t in SPECIAL if text.startswith(t)), None)
+            if found:
+                ids.append(SPECIAL[found])
+                text = text[len(found):]
+            else:
+                ids.append(ord(text[0]))
+                text = text[1:]
+        return {"input_ids": ids}
+
+
+class ImageProcessor:
+    """Fits a 64x64-patch picture under max_pixels: the grid shrinks with the cap; pixels carry the picture's name."""
+
+    max_pixels, min_pixels = 1024**2, 32**2
+
+    def __init__(self):
+        self.calls = []
+
+    def __call__(self, *, images, max_pixels, min_pixels):
+        self.calls.append(max_pixels)
+        side = 2
+        while ((side + 2) * 16) ** 2 <= max_pixels and side < 8:
+            side += 2                                    # merge-aligned sides, at most 8 patches
+        name = images[0]
+        fill = int(hashlib.sha256(name.encode()).hexdigest()[:4], 16) / 65536.0
+        pixels = np.full((side * side, 1536), fill, np.float32)
+        return {"pixel_values": pixels, "image_grid_thw": np.array([[1, side, side]])}
+
+
+def picture(name, detail="auto"):
+    return NS(content_hash="sha-" + name, detail=detail, to_pil=lambda: name)
+
+
+def front():
+    return QwenImageProcessor(CONFIG, ImageProcessor(), Tokenizer())
+
+
+def prompt(n):
+    return "".join(f"t{i}<start><image><end>" for i in range(n)) + "end"
+
+
+def test_keys_tell_pictures_apart_by_content_cap_and_grid():
+    assert image_key("a", 4096, (1, 4, 4)) == image_key("a", 4096, (1, 4, 4))
+    assert len(image_key("a", 4096, (1, 4, 4))) == 16
+    assert image_key("a", 4096, (1, 4, 4)) != image_key("b", 4096, (1, 4, 4))   # same grid, other pixels
+    assert image_key("a", 4096, (1, 4, 4)) != image_key("a", 2048, (1, 4, 4))   # fitted under another cap
+    assert image_key("a", 4096, (1, 4, 4)) != image_key("a", 4096, (1, 2, 8))   # another grid
