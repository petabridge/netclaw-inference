+    assert not prepared.fixed_cap
+    assert prepared.image_caps == ((64 // 5) * 32**2,) * 5
+
+
+def test_low_detail_and_the_per_image_ceiling_still_apply_under_the_fixed_cap():
+    prepared = front().prepare(prompt(2), [picture("a", "low"), picture("b")], max_visual_tokens=64,
+                               fixed_image_tokens=16, max_image_tokens=8)
+    assert prepared.fixed_cap and prepared.image_caps == (8 * 32**2, 8 * 32**2)
