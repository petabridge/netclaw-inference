+def test_without_the_fixed_cap_an_added_image_refits_the_others_and_changes_their_keys():
+    two = front().prepare(prompt(2), [picture("a"), picture("b")], max_visual_tokens=64)
+    three = front().prepare(prompt(3), [picture("a"), picture("b"), picture("c")], max_visual_tokens=64)
+    assert not two.fixed_cap and not three.fixed_cap
