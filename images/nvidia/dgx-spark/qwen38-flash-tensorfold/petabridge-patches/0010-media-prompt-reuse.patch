new file mode 100644
index 0000000..2d996a3
--- /dev/null
+++ b/zig/src/core/prompt_cache_media_test.zig
@@ -0,0 +1,159 @@
+//! Image prompts in the prompt cache: kept states are found by `mediaKeyed` ids, so two pictures with the same grid
+//! (the same placeholder tokens) never share a state, while the same picture resumes exactly. The fake family's
+//! state is a running sum over the keyed ids, standing in for the picture features a real prompt pass reads.
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const Allocator = std.mem.Allocator;
+
+const Fake = struct {
+    gpa: Allocator,
+    at: u32 = 0,
+    sum: u64 = 0,
+
+    const State = struct { at: u32, sum: u64 };
+
+    fn snapshots(f: *Fake) pc.Snapshots {
+        return .{ .ptr = f, .vtable = &.{ .bytes = bytesFn, .save = saveFn, .restore = restoreFn, .drop = dropFn } };
+    }
+    fn of(ptr: *anyopaque) *Fake {
+        return @ptrCast(@alignCast(ptr));
+    }
+    fn bytesFn(_: *anyopaque, at: u32) u64 {
+        return 100 + at;
+    }
+    fn saveFn(ptr: *anyopaque, _: ?*anyopaque, at: u32) anyerror!pc.Saved {
+        const f = of(ptr);
+        if (at != f.at) return error.NotAtMark;
+        const st = try f.gpa.create(State);
+        st.* = .{ .at = f.at, .sum = f.sum };
+        return st;
+    }
+    fn restoreFn(ptr: *anyopaque, _: ?*anyopaque, saved: pc.Saved) anyerror!void {
+        const st: *State = @ptrCast(@alignCast(saved));
+        of(ptr).at, of(ptr).sum = .{ st.at, st.sum };
+    }
+    fn dropFn(ptr: *anyopaque, saved: pc.Saved) void {
+        const st: *State = @ptrCast(@alignCast(saved));
+        of(ptr).gpa.destroy(st);
+    }
+
+    /// A pass over `keyed` (the ids the cache sees, which carry each picture's content) from plan.from.
+    fn pass(f: *Fake, s: *pc.Store, keyed: []const u32, plan: pc.Plan) u64 {
+        if (plan.from == 0) f.* = .{ .gpa = f.gpa };
+        var mi: usize = 0;
+        for (keyed[plan.from..]) |t| {
+            f.sum = f.sum *% 31 +% t;
+            f.at += 1;
+            if (mi < plan.marks.len and plan.marks[mi] == f.at) {
+                _ = s.keep(keyed, f.at, null);
+                mi += 1;
+            }
+        }
+        return f.sum;
+    }
+};
+
+fn fresh(keyed: []const u32) u64 {
+    var sum: u64 = 0;
+    for (keyed) |t| sum = sum *% 31 +% t;
+    return sum;
+}
+
+const PAD: u32 = 77; // the image placeholder id: the same for every picture
+
+test "keyed ids: picture rows carry the key and their row, text rows stay, and bad spans are refused" {
+    const a = std.testing.allocator;
+    const prompt = [_]u32{ 1, 2, PAD, PAD, PAD, PAD, 3, 4 };
+    const k1 = try pc.mediaKeyed(a, &prompt, &.{.{ .start = 2, .end = 6, .key = 0x1111 }});
+    defer a.free(k1);
+    const k1b = try pc.mediaKeyed(a, &prompt, &.{.{ .start = 2, .end = 6, .key = 0x1111 }});
+    defer a.free(k1b);
+    const k2 = try pc.mediaKeyed(a, &prompt, &.{.{ .start = 2, .end = 6, .key = 0x2222 }});
+    defer a.free(k2);
+    try std.testing.expectEqualSlices(u32, k1, k1b); // deterministic
+    try std.testing.expect(k1[0] & 0x8000_0000 != 0 and k1[0] == k2[0]); // row 0 tagged: never a text prompt's state
+    try std.testing.expectEqual(prompt[1], k1[1]);
+    try std.testing.expectEqualSlices(u32, prompt[6..], k1[6..]);
+    const plain = try pc.mediaKeyed(a, &prompt, &.{}); // no pictures: the prompt as it is
+    defer a.free(plain);
+    try std.testing.expectEqualSlices(u32, &prompt, plain);
+    for (2..6) |r| {
+        try std.testing.expect(k1[r] & 0x8000_0000 != 0); // never a real token id
+        try std.testing.expect(k1[r] != k2[r]); // another picture differs at every row
+    }
+    // rows of one picture differ from each other (a picture is not a run of one repeated id)
+    try std.testing.expect(k1[2] != k1[3] and k1[3] != k1[4]);
+    try std.testing.expectError(error.BadMediaSpans, pc.mediaKeyed(a, &prompt, &.{.{ .start = 6, .end = 9, .key = 1 }}));
+    try std.testing.expectError(error.BadMediaSpans, pc.mediaKeyed(a, &prompt, &.{ .{ .start = 2, .end = 5, .key = 1 }, .{ .start = 4, .end = 6, .key = 2 } }));
+    try std.testing.expectError(error.BadMediaSpans, pc.mediaKeyed(a, &prompt, &.{.{ .start = 3, .end = 3, .key = 1 }}));
+}
+
+test "two different pictures with the same grid never share a kept state; the same picture resumes and equals a fresh pass" {
+    const gpa = std.testing.allocator;
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var f: Fake = .{ .gpa = gpa };
+    var s = pc.Store.init(gpa, f.snapshots(), .{ .min_prompt = 0, .min_gap = 1 }, 1 << 20);
+    defer s.deinit();
+    // turn 1: text, picture A (4 rows), text; history ends at 8
+    const t1 = [_]u32{ 1, 2, PAD, PAD, PAD, PAD, 3, 4, 9, 9 };
+    const span = [_]pc.MediaSpan{.{ .start = 2, .end = 6, .key = 0xA }};
+    const k1 = try pc.mediaKeyed(a, &t1, &span);
+    var p = try s.begin(a, k1, 8, &.{}, &.{}, null);
+    try std.testing.expectEqual(@as(u32, 0), p.from);
+    try std.testing.expectEqualSlices(u32, &.{8}, p.marks);
+    try std.testing.expectEqual(fresh(k1), f.pass(&s, k1, p));
+
+    // turn 2, same picture A: resumes at 8, past the picture, and equals a fresh pass over the same keyed ids
+    const t2 = [_]u32{ 1, 2, PAD, PAD, PAD, PAD, 3, 4, 9, 5, 6, 9, 9 };
+    const k2 = try pc.mediaKeyed(a, &t2, &span);
+    p = try s.begin(a, k2, 11, &.{}, &.{}, null);
+    try std.testing.expectEqual(@as(u32, 8), p.from);
+    try std.testing.expectEqual(fresh(k2), f.pass(&s, k2, p));
+
+    // the same conversation shape with picture B (same grid, same placeholder tokens): no kept state matches past
+    // its first row, so the pass starts from 0, never from A's state
+    const kb = try pc.mediaKeyed(a, &t2, &.{.{ .start = 2, .end = 6, .key = 0xB }});
+    try std.testing.expect(s.find(kb, &.{}) == null);
+    try std.testing.expect(!std.mem.eql(u32, k2, kb)); // the real prompt is the same for both: only the key tells them apart
+    p = try s.begin(a, kb, 11, &.{}, &.{}, null);
+    try std.testing.expectEqual(@as(u32, 0), p.from);
+    try std.testing.expectEqual(fresh(kb), f.pass(&s, kb, p));
+}
+
+test "a new picture in the suffix resumes the kept state before it, and the pass from there equals a fresh one" {
+    const gpa = std.testing.allocator;
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var f: Fake = .{ .gpa = gpa };
+    var s = pc.Store.init(gpa, f.snapshots(), .{ .min_prompt = 0, .min_gap = 1 }, 1 << 20);
+    defer s.deinit();
+    const t1 = [_]u32{ 1, PAD, PAD, 2, 3, 9 };
+    const a_span = pc.MediaSpan{ .start = 1, .end = 3, .key = 0xA };
+    const k1 = try pc.mediaKeyed(a, &t1, &.{a_span});
+    _ = f.pass(&s, k1, try s.begin(a, k1, 5, &.{}, &.{}, null)); // keeps at 5
+    // turn 2 adds picture C after the history
+    const t2 = [_]u32{ 1, PAD, PAD, 2, 3, 9, 4, PAD, PAD, PAD, 5, 9 };
+    const k2 = try pc.mediaKeyed(a, &t2, &.{ a_span, .{ .start = 7, .end = 10, .key = 0xC } });
+    const p = try s.begin(a, k2, 11, &.{}, &.{}, null);
+    try std.testing.expectEqual(@as(u32, 5), p.from);
+    try std.testing.expectEqual(fresh(k2), f.pass(&s, k2, p));
+}
+
+test "a kept state inside a picture's rows resumes only the same picture" {
+    const gpa = std.testing.allocator;
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var f: Fake = .{ .gpa = gpa };
+    var s = pc.Store.init(gpa, f.snapshots(), .{ .min_prompt = 0, .min_gap = 1 }, 1 << 20);
+    defer s.deinit();
+    const t = [_]u32{ 1, PAD, PAD, PAD, PAD, 2, 9 };
+    const ka = try pc.mediaKeyed(a, &t, &.{.{ .start = 1, .end = 5, .key = 0xA }});
+    _ = f.pass(&s, ka, try s.begin(a, ka, 3, &.{}, &.{}, null)); // mark at 3: inside the picture
+    const kb = try pc.mediaKeyed(a, &t, &.{.{ .start = 1, .end = 5, .key = 0xB }});
+    try std.testing.expect(s.find(kb, &.{}) == null);
+    try std.testing.expectEqual(@as(u32, 3), s.find(ka, &.{}).?.at);
+}
