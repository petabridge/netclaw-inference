new file mode 100644
index 0000000..fe09c9d
--- /dev/null
+++ b/src/tensorfold/vision/media_keys.py
@@ -0,0 +1,115 @@
+"""PETABRIDGE 0010: per-picture content keys for exact prompt reuse of image prompts, and a host-side cache of each
+picture's tower features.
+
+Placeholder tokens are the same id for every picture, so the Zig engine's prompt cache cannot tell two pictures with
+the same grid apart by tokens alone. Each picture's (or video frame group's) prompt rows get a 64-bit key of what
+fills them: the decoded pixels' content hash, the pixel cap it was fitted under and its processed grid. The engine
+writes the key into those rows of the ids it keys kept states by (``prompt_cache.mediaKeyed``).
+
+The approach follows the GLM-5.3-Flash TensorFold recipe's image prompt reuse (MiaAI-Lab, issue #11 of that recipe):
+keys substituted into the picture rows, features computed only where needed. Apache-2.0.
+"""
+
+from __future__ import annotations
+
+from collections import OrderedDict
+import hashlib
+import os
+from typing import Any, Sequence
+
+KEY_VERSION = b"tensorfold-qwen-media-key-v1\0"
+
+
+def _key(*parts: Any) -> str:
+    digest = hashlib.sha256(KEY_VERSION)
+    for part in parts:
+        digest.update(repr(part).encode())
+        digest.update(b"\0")
+    return digest.hexdigest()[:16]
+
+
+def image_key(content_hash: str, cap: int, grid: Sequence[int]) -> str:
+    """One picture's key (16 hex): its decoded pixels, the pixel cap it was fitted under and its processed grid."""
+
+    return _key("image", content_hash, int(cap), tuple(int(v) for v in grid))
+
+
+def item_keys(prepared) -> list[tuple[int, int, str]]:
+    """Every picture's and video frame group's prompt rows [start, end) with its key, ascending; [] when the prepared
+    prompt does not say enough to key every item (no prompt reuse then, never a wrong one)."""
+
+    out: list[tuple[int, int, str]] = []
+    spans = tuple(prepared.image_spans)
+    hashes = tuple(getattr(prepared, "image_hashes", ()))
+    caps = tuple(getattr(prepared, "image_caps", ()))
+    grid = prepared.image_grid_thw
+    if len(hashes) != len(spans) or len(caps) != len(spans) or len(grid) != len(spans):
+        return []
+    for (start, end), h, cap, g in zip(spans, hashes, caps, grid):
+        out.append((int(start), int(end), image_key(h, cap, g)))
+    frames = tuple(getattr(prepared, "video_spans", ()))
+    if frames:
+        videos = getattr(prepared, "video_grid_thw", None)
+        vhashes = tuple(getattr(prepared, "video_hashes", ()))
+        if videos is None or len(vhashes) != len(videos):
+            return []
+        groups = []                      # one frame group a temporal step of each video, as media_positions splits it
+        for vh, (t, h, w) in zip(vhashes, videos):
+            for j in range(int(t)):
+                groups.append(_key("video", vh, (int(t), int(h), int(w)), j, len(videos)))
+        if len(groups) != len(frames):
+            return []
+        out.extend((int(s), int(e), k) for (s, e), k in zip(frames, groups))
+    out.sort()
+    if any(end <= start for start, end, _ in out) or any(b[0] < a[1] for a, b in zip(out, out[1:])):
+        return []
+    return out
+
+
+def env_int(name: str, default: int, low: int, high: int) -> int:
+    raw = os.environ.get(name, "").strip()
+    if not raw:
+        return default
+    value = int(raw)
+    if not low <= value <= high:
+        raise ValueError(f"{name} must be from {low} to {high}, not {value}")
+    return value
+
+
+class FeatureCache:
+    """Each picture's tower rows by its key, in host memory, least recently used first out, at most ``limit``
+    bytes. A picture is encoded alone, so its rows do not depend on the other pictures of the request: a hit is the
+    same bits a fresh encode gives."""
+
+    def __init__(self, limit: int) -> None:
+        self.limit = int(limit)
+        self.held = 0
+        self.items: OrderedDict[str, Any] = OrderedDict()
+        self.hits = 0
+        self.misses = 0
+
+    @staticmethod
+    def _bytes(value) -> int:
+        return int(value.numel()) * int(value.element_size())
+
+    def get(self, key: str):
+        value = self.items.get(key)
+        if value is None:
+            self.misses += 1
+            return None
+        self.items.move_to_end(key)
+        self.hits += 1
+        return value
+
+    def put(self, key: str, value) -> None:
+        size = self._bytes(value)
+        if size > self.limit:
+            return
+        old = self.items.pop(key, None)
+        if old is not None:
+            self.held -= self._bytes(old)
+        while self.items and self.held + size > self.limit:
+            _, gone = self.items.popitem(last=False)
+            self.held -= self._bytes(gone)
+        self.items[key] = value
+        self.held += size
