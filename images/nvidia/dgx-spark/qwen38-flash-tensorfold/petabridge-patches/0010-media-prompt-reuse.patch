+/// key). Placeholder tokens are all the same id, so a kept state of an image prompt is found by `mediaKeyed` ids.
+pub const MediaSpan = struct { start: u32, end: u32, key: u64 };
+
+/// A prompt's ids with every picture row replaced by 0x80000000 | (hash(key, row) & 0x7fffffff): equal prefixes then
+/// mean the same pictures in the same places, not only the same placeholder tokens. Real ids stay below 2^31 (every
+/// vocabulary does), so a keyed row never equals a token. Spans must be ascending, inside the prompt, not overlapping.
+/// Row 0 is tagged too (0x80000000 | hash(token 0)): an image prompt's text rows rotate through its rotary table
+/// (another kernel mode than a text prompt's), so its states and a text prompt's are never taken for each other, even
+/// before its first picture. Image prompts still share their common prefix with each other.
+pub fn mediaKeyed(a: Allocator, prompt: []const u32, spans: []const MediaSpan) error{ OutOfMemory, BadMediaSpans }![]u32 {
+    const out = try a.dupe(u32, prompt);
+    errdefer a.free(out);
+    if (spans.len == 0) return out;
+    if (prompt.len > 0) out[0] = 0x8000_0000 | @as(u32, @truncate(std.hash.Wyhash.hash(0x6d656469615f7230, std.mem.asBytes(&prompt[0])) & 0x7fff_ffff));
+    var last: u32 = 0;
+    for (spans) |sp| {
+        if (sp.start < last or sp.end <= sp.start or sp.end > prompt.len) return error.BadMediaSpans;
+        for (sp.start..sp.end) |r| {
+            var words: [2]u64 = .{ sp.key, r - sp.start };
+            const h = std.hash.Wyhash.hash(0x6d656469615f6b65, std.mem.sliceAsBytes(&words));
+            out[r] = 0x8000_0000 | @as(u32, @truncate(h & 0x7fff_ffff));
+        }
+        last = sp.end;
+    }
+    return out;
+}
+
