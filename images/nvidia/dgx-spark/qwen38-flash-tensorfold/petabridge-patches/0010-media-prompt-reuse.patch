+pub fn historyLen(tokens: []const u32, suffix: ?[]const u32) usize {
+    const sfx = suffix orelse return 0;
+    if (sfx.len == 0) return if (tokens.len > 1) tokens.len - 1 else 0; // a template with no generation suffix
+    if (sfx.len >= tokens.len or !std.mem.endsWith(u32, tokens, sfx)) return 0;
+    return tokens.len - sfx.len;
+}
