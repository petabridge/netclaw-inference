+/// PETABRIDGE 0010: the helper's ``item_keys`` ([[start, end, "16 hex"], ...], ascending) as spans, checked against
+/// the media's feature rows: together the spans must hold exactly those rows. Anything else: none (no prompt reuse
+/// for the request, never a wrong one).
+pub fn parseSpans(a: Allocator, v: ?Value, rows: []const u32, prompt_len: usize) []const api.prompt_cache.MediaSpan {
+    const list = (v orelse return &.{}).items() orelse return &.{};
+    if (list.len == 0) return &.{};
+    const out = a.alloc(api.prompt_cache.MediaSpan, list.len) catch return &.{};
+    var at: usize = 0; // the next feature row the spans must cover
+    var last: u32 = 0;
+    for (list, out) |item, *o| {
+        const f = item.items() orelse return &.{};
+        if (f.len != 3) return &.{};
+        const start = std.math.cast(u32, f[0].int64() orelse return &.{}) orelse return &.{};
+        const end = std.math.cast(u32, f[1].int64() orelse return &.{}) orelse return &.{};
+        const hex = f[2].str() orelse return &.{};
+        if (hex.len != 16 or start < last or end <= start or end > prompt_len) return &.{};
+        const key = std.fmt.parseInt(u64, hex, 16) catch return &.{};
+        for (start..end) |r| {
+            if (at >= rows.len or rows[at] != r) return &.{};
+            at += 1;
+        }
+        o.* = .{ .start = start, .end = end, .key = key };
+        last = end;
+    }
+    if (at != rows.len) return &.{};
+    return out;
+}
