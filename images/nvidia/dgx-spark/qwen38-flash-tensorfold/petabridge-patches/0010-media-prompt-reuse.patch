+
+def test_item_keys_cover_each_pictures_rows_or_nothing():
+    prepared = front().prepare(prompt(2), [picture("a"), picture("b")], max_visual_tokens=64,
+                               fixed_image_tokens=16)
+    keys = item_keys(prepared)
+    assert [(s, e) for s, e, _ in keys] == list(prepared.image_spans)
+    assert keys[0][2] != keys[1][2]
+    # a prepared prompt that does not say enough to key every picture: no keys (no reuse, never a wrong one)
+    from dataclasses import replace
+    assert item_keys(replace(prepared, image_caps=prepared.image_caps[:1])) == []
+    assert item_keys(replace(prepared, image_hashes=())) == []
