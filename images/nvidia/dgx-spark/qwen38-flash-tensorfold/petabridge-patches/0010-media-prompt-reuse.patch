+def test_a_fixed_cap_never_refits_earlier_images_when_one_is_added():
+    two = front().prepare(prompt(2), [picture("a"), picture("b")], max_visual_tokens=64, fixed_image_tokens=16)
+    three = front().prepare(prompt(3), [picture("a"), picture("b"), picture("c")], max_visual_tokens=64,
+                            fixed_image_tokens=16)
+    assert two.fixed_cap and three.fixed_cap
+    assert two.image_caps == three.image_caps[:2] == (16 * 32**2,) * 2
+    assert item_keys(two) == item_keys(three)[:2]                   # the same keys, rows and grids
+    assert three.token_ids[:len(two.token_ids) - 3] == two.token_ids[:-3]   # the earlier turn's rows unchanged
